<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>com.musica</groupId>
    <artifactId>musica-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>musica-api</name>
    <description>API REST básica de un catálogo musical (actividad universitaria)</description>

    <properties>
        <java.version>22</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Arrancador web: incluye Spring MVC, Tomcat embebido y Jackson (JSON) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Utilidades de prueba: JUnit, MockMvc, etc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!--
                        La JVM, por defecto, reserva como heap maximo 1/4 de la RAM
                        del equipo (unos 4 GB aqui). En una maquina con poca memoria
                        libre esa reserva falla y el proceso muere al arrancar con
                        "insufficient memory for the Java Runtime Environment".
                        Esta API cabe de sobra en 512 MB.
                    -->
                    <jvmArguments>-Xms64m -Xmx512m -XX:ReservedCodeCacheSize=96m</jvmArguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
